# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/sgd

# JWT
JWT_SECRET=sua-chave-secreta-mude-em-producao-2024
JWT_EXPIRES_IN=24h

# Seed de usuários iniciais — OBRIGATÓRIO em produção (NODE_ENV=production).
# Sem estas variáveis, o servidor recusa iniciar (seed.ts falha por design,
# para nunca criar contas administrativas com senha previsível).
# Requisitos: >= 12 caracteres, com maiúscula, minúscula, número e caractere
# especial. Nunca reutilize o valor de exemplo abaixo — é só ilustrativo.
# SEED_ADMIN_PASSWORD=Troque-Esta#Senha123
# SEED_VIEWER_PASSWORD=Troque-Esta#Senha124
# SEED_GESTOR_PASSWORD=Troque-Esta#Senha125
# SEED_ANALISTA_PASSWORD=Troque-Esta#Senha126
# SEED_DIRETOR_PASSWORD=Troque-Esta#Senha127
# SEED_TECNICO_PASSWORD=Troque-Esta#Senha128
# SEED_PARCEIRO_PASSWORD=Troque-Esta#Senha129
# SEED_CLIENTE_PASSWORD=Troque-Esta#Senha130
# SEED_VISITANTE_PASSWORD=Troque-Esta#Senha131

# CORS
CORS_ORIGIN=https://gruposgd.com.br,https://www.gruposgd.com.br
FRONTEND_URL=https://gruposgd.com.br

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Integrações governamentais — sincronização periódica
# Intervalo (ms) entre verificações do agendador (padrão 60_000 = 1 minuto).
INTEGRATION_SYNC_INTERVAL_MS=60000

# Transferegov — a chave DEFINE o nome da env var; o VALOR fica aqui.
# Homologação: https://api-homolog.transferegov.gov.br | Produção: https://api.transferegov.gov.br
TRANSFEREGOV_BASE_URL=https://api-homolog.transferegov.gov.br
TRANSFEREGOV_API_KEY=troque-pela-chave-da-integracao

# SEI / CGLOG — preparados, ativar apenas quando houver contrato/endpoint.
# SEI_BASE_URL=https://api.sei.gov.br
# SEI_API_KEY=troque-pela-chave
# CGLOG_BASE_URL=https://api.cglog.gov.br
# CGLOG_API_KEY=troque-pela-chave